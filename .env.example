# Copy to .env (git-ignored) for `docker compose up`. The deploy workflow sets
# these from repository secrets instead.

# Shared secret for every MCP request: openssl rand -hex 32
PD_MCP_TOKEN=

# tiingo (default, full history) | massive (2 years) | fixture (offline demo)
PD_PROVIDER=tiingo
TIINGO_API_KEY=
MASSIVE_API_KEY=

# SEC requires a contact e-mail in the User-Agent for EDGAR requests
PD_SEC_CONTACT=

# Public hostname your cloudflared tunnel routes to localhost:8765
PD_ALLOWED_HOSTS=pd.example.com

# Layer 2 scan (spec 004): massive (grouped daily; verify with
# `./run.sh scan --check-source`) | payload (brokerage payload files in
# PD_PAYLOAD_DIR) | off
PD_SCAN_SOURCE=off
# on = refresh weekdays at PD_SCAN_TIMES (US/Eastern) inside the container
PD_SCHEDULE=off
PD_SCAN_TIMES=10:00,12:30,15:00,17:30

# Community site (spec 006). Exact prices stay off until you have checked
# your data provider's licence allows republishing them.
PD_SITE_PRICES=off
# Link for community stories, e.g. https://github.com/red-flag-club/red-flag-club/discussions
PD_SITE_DISCUSSIONS=

# Community stories (spec 007)
# Public URL of the site, for Facebook / YouTube / X link previews
PD_SITE_URL=
# The Cloudflare Worker that receives stories (docs/stories.md); empty = sharing off
PD_STORIES_SUBMIT_URL=
# Optional Cloudflare Turnstile site key for the share form
PD_TURNSTILE_SITEKEY=
